# Dependencies - restored via npm install / forge install, never committed
node_modules/
lib/

# Environment secrets - NEVER commit these, they hold real private keys
.env
.env.local
.env.*.local
deploy/.env
agent/.env
frontend/.env.local

# Foundry build cache and broadcast logs - regenerated by forge build,
# not needed in the repo. NOTE: out/ is deliberately NOT listed here -
# it holds the compiled ABI/bytecode that deploy/artifact.js reads, and
# keeping it committed means anyone cloning this repo can run the deploy
# scripts immediately without needing Foundry installed at all.
cache/
broadcast/

# Next.js build output
frontend/.next/
.next/

# Agent's local fallback reasoning logs - not needed in the repo,
# real reasoning lives on IPFS
agent/logs/
*.log

# OS junk
.DS_Store
Thumbs.db